<Window x:Class="BsAutoRec.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:models="clr-namespace:BsAutoRec.Models"
		mc:Ignorable="d"
		Title="BsAutoRec"
		Icon="pack://application:,,,/Assets/icon.ico"
		Width="900"
		Height="720"
		MinWidth="820"
		MinHeight="680">
	<Window.Resources>
		<Style x:Key="StatusCardBorderStyle" TargetType="{x:Type Border}">
			<Setter Property="Background" Value="#FFF3F4F6" />
			<Setter Property="BorderBrush" Value="#FFD1D5DB" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="8" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:StatusSeverity.Ok}">
					<Setter Property="Background" Value="#FFEAF7EE" />
					<Setter Property="BorderBrush" Value="#FF8FCAA2" />
				</DataTrigger>
				<DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:StatusSeverity.Waiting}">
					<Setter Property="Background" Value="#FFFFF7E6" />
					<Setter Property="BorderBrush" Value="#FFE7BF65" />
				</DataTrigger>
				<DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:StatusSeverity.Attention}">
					<Setter Property="Background" Value="#FFFFECEC" />
					<Setter Property="BorderBrush" Value="#FFE39090" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
	</Window.Resources>
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="16" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="16" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Border Grid.Row="0"
				Padding="16"
				Tag="{Binding AppStatusSeverity.Value}"
				Style="{StaticResource StatusCardBorderStyle}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<StackPanel>
					<TextBlock FontSize="28"
							   FontWeight="SemiBold"
							   Text="{Binding StatusText.Value}" />
					<TextBlock Margin="0,6,0,0"
							   Foreground="#FF4B5563"
							   Text="{Binding MessageText.Value}" />
				</StackPanel>

				<StackPanel Grid.Column="1">
					<StackPanel
							HorizontalAlignment="Right"
							Orientation="Horizontal"
							Height="50">
						<Button Width="120"
								Margin="0,0,8,0"
								Command="{Binding StartCommand}"
								Content="▶ 開始" />
						<Button Width="120"
								Command="{Binding StopCommand}"
								Content="⏹️ 停止" />
					</StackPanel>
					<CheckBox Margin="7"
                              IsChecked="{Binding AutoStart.Value}"
							  Content="起動時に自動開始する" />

				</StackPanel>
			</Grid>
		</Border>

		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="2*" />
				<ColumnDefinition Width="16" />
				<ColumnDefinition Width="3*" />
			</Grid.ColumnDefinitions>

			<GroupBox Header="接続状態">
				<Grid Margin="8">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="8" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="8" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<Border Grid.Row="0"
							Padding="10"
							Tag="{Binding BsConnectionSeverity.Value}"
							Style="{StaticResource StatusCardBorderStyle}">
						<DockPanel>
							<TextBlock Width="80"
									   FontWeight="SemiBold"
									   Text="BS" />
							<TextBlock Text="{Binding BsConnectionText.Value}" TextWrapping="Wrap" />
						</DockPanel>
					</Border>

					<Border Grid.Row="2"
							Padding="10"
							Tag="{Binding ObsConnectionSeverity.Value}"
							Style="{StaticResource StatusCardBorderStyle}">
						<DockPanel>
							<TextBlock Width="80"
									   FontWeight="SemiBold"
									   Text="OBS" />
							<TextBlock Text="{Binding ObsConnectionText.Value}" TextWrapping="Wrap" />
						</DockPanel>
					</Border>

				</Grid>
			</GroupBox>

			<GroupBox Grid.Column="2" Header="現在のプレイ情報">
				<Grid Margin="8">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="140" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,6" FontWeight="SemiBold" Text="SongName" />
					<TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" Text="{Binding SongNameText.Value}" TextWrapping="Wrap" />
					<TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,6" FontWeight="SemiBold" Text="SongSubName" />
					<TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" Text="{Binding SongSubNameText.Value}" TextWrapping="Wrap" />
					<TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,6" FontWeight="SemiBold" Text="SongAuthorName" />
					<TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" Text="{Binding SongAuthorNameText.Value}" TextWrapping="Wrap" />
					<TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,6" FontWeight="SemiBold" Text="LevelAuthorName" />
					<TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" Text="{Binding LevelAuthorNameText.Value}" TextWrapping="Wrap" />
					<TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,6" FontWeight="SemiBold" Text="Difficulty" />
					<TextBlock Grid.Row="4" Grid.Column="1" Margin="0,0,0,6" Text="{Binding DifficultyText.Value}" TextWrapping="Wrap" />
					<TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,8,6" FontWeight="SemiBold" Text="ScorePercent" />
					<TextBlock Grid.Row="5" Grid.Column="1" Margin="0,0,0,6" Text="{Binding ScorePercentText.Value}" TextWrapping="Wrap" />
					<TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,8,6" FontWeight="SemiBold" Text="LevelEndType" />
					<TextBlock Grid.Row="6" Grid.Column="1" Margin="0,0,0,6" Text="{Binding LevelEndTypeText.Value}" TextWrapping="Wrap" />
					<TextBlock Grid.Row="7" Grid.Column="0" Margin="0,0,8,0" FontWeight="SemiBold" Text="録画ファイル" />
					<TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding RecordingPathText.Value}" TextWrapping="Wrap" />
				</Grid>
			</GroupBox>
		</Grid>

		<Grid Grid.Row="4">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="16" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<Expander Header="設定"
					  IsExpanded="{Binding IsSettingsExpanded.Value}">
				<Grid Margin="8">
					<Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="BS WebSocket URL" />
					<TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Text="{Binding BsWebSocketUrl.Value, UpdateSourceTrigger=PropertyChanged}" />
					<TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="OBS WebSocket URL" />
					<TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding ObsWebSocketUrl.Value, UpdateSourceTrigger=PropertyChanged}" />
					<TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="OBS Password" />
					<TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Text="{Binding ObsPassword.Value, UpdateSourceTrigger=PropertyChanged}" />
					<TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="復旧待機秒数" />
					<TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Text="{Binding RecoveryWaitSeconds.Value, UpdateSourceTrigger=PropertyChanged}" />
					<TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="録画停止ディレイ秒数" />
					<TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Text="{Binding RecordingStopDelaySeconds.Value, UpdateSourceTrigger=PropertyChanged}" />
					<TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="フェイル時追加ディレイ秒数" />
					<TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" Text="{Binding FailedRecordingStopAdditionalDelaySeconds.Value, UpdateSourceTrigger=PropertyChanged}" />
					<TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="録画出力フォルダ" />
					<Grid
                        Grid.Row="6"
						Grid.Column="1"
                        Grid.ColumnSpan="2"
						Margin="0,0,0,8">
                        <TextBox Text="{Binding RecordingOutputDirectory.Value, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,103,0" />
                        <Button Width="50"
								HorizontalAlignment="Right"
								Margin="0,0,48,0"
								Command="{Binding OutputDirectoryFolderCommand}"
								Content="Select..." />
                        <Button Width="40"
								HorizontalAlignment="Right"
								Command="{Binding OpenOutputDirectoryCommand}"
								Content="開く" />
                    </Grid>
					<TextBlock Grid.Row="7" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="ファイル名テンプレート" />
					<TextBox Grid.Row="7"
							 Grid.Column="1"
							 Grid.ColumnSpan="2"
							 Margin="0,0,0,8"
							 Text="{Binding RenameTemplate.Value, UpdateSourceTrigger=PropertyChanged}"
							 TextWrapping="Wrap"
							 AcceptsReturn="True"
							 MinHeight="64" />
                    <StackPanel Grid.Row="0"
								Grid.Column="2"
                                Grid.RowSpan="2"
								Orientation="Horizontal"
								HorizontalAlignment="Right">
						<Button Width="80"
								Margin="0,0,8,0"
								Command="{Binding ReloadSettingsCommand}"
								Content="再読込" />
						<Button Width="80"
								Command="{Binding SaveSettingsCommand}"
								Content="保存" />
					</StackPanel>
				</Grid>
			</Expander>

			<GroupBox Grid.Row="2" Header="直近メッセージ">
				<TextBox Margin="8"
						 IsReadOnly="True"
						 BorderThickness="0"
						 Background="Transparent"
						 Text="{Binding RecentMessagesText.Value}"
						 TextWrapping="Wrap"
						 VerticalScrollBarVisibility="Auto"
						 AcceptsReturn="True" />
			</GroupBox>
		</Grid>
	</Grid>
</Window>
